# =============================================================================
# Argus MCPS — .gitignore
# =============================================================================

# --- Artefatos de build (Kas / Yocto) ---
build/

# --- Repos gerenciados pelo Kas (não precisa mais de submodules) ---
poky/
meta-raspberrypi/
meta-openembedded/
meta-rauc/

# --- Certificados e chaves (gerados por generate_dev_certs.sh) ---
meta-infusion-pump/recipes-connectivity/mosquitto/files/certs/
meta-infusion-pump/recipes-core/bundles/files/*.pem
meta-infusion-pump/recipes-support/rauc/files/keyring.pem
backend_certs/

# --- Build intermediário do C++ ---
meta-infusion-pump/recipes-apps/infusion-control/files/src/build/

# --- Firmwares de teste ---
test_firmware/

# --- Temporários de editor/IDE ---
__pycache__/
*.pyc
.vscode/
*.swp
*~
.idea/

# --- Yocto/BitBake ---
bitbake.lock
pseudodone
toaster.sqlite
toaster_ui.log

# --- Manter pastas vazias no git ---
!meta-infusion-pump/recipes-connectivity/mosquitto/files/certs/.gitkeep
!meta-infusion-pump/recipes-core/bundles/files/.gitkeep
!meta-infusion-pump/recipes-support/rauc/files/.gitkeep
